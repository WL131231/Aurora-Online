{
  "name": "aurora-online",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build && npm --workspace server run build",
    "typecheck": "npm --workspace client run typecheck && npm --workspace server run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "sharp": "^0.34.5"
  }
}
